#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# battery calibration
param set-default BAT1_SOURCE 0
param set-default BAT1_N_CELLS 6
param set-default BAT1_V_EMPTY 3.6
param set-default BAT1_V_CHARGED 4.2

param set-default BAT2_SOURCE 0
param set-default BAT2_N_CELLS 144
param set-default BAT2_V_EMPTY 3.6
param set-default BAT2_V_CHARGED 4.2

param set-default BAT1_V_DIV 18
param set-default BAT2_V_DIV 18

param set-default BAT1_A_PER_V 24
param set-default BAT2_A_PER_V 24

# Enable IMU thermal control
param set-default SENS_EN_THERMAL 1

param set-default SENS_TEMP_ID 6946850

param set-default UAVCAN_ENABLE 0

# Actuator outputs
param set-default CAN_EC_FUNC1 101
param set-default CAN_EC_FUNC2 102
param set-default CAN_EC_FUNC3 103

param set-default CAN_SV_FUNC1 201
param set-default CAN_SV_FUNC2 201
param set-default CAN_SV_FUNC3 202
param set-default CAN_SV_FUNC4 202

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 201
param set-default PWM_MAIN_FUNC5 201
param set-default PWM_MAIN_FUNC6 202
param set-default PWM_MAIN_FUNC7 202


rgbled_pwm start
safety_button start
evtol_gpio start
evtol_can start
